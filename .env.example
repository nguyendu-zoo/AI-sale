# Copy/generate to .env. Never commit .env or integration credentials.
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://aisales:SET_LOCAL_PASSWORD@localhost:55432/aisales?schema=public
TEST_DATABASE_URL=postgresql://aisales:SET_LOCAL_PASSWORD@localhost:55432/aisales_test?schema=public
# Keep REDIS_PORT and the port in REDIS_URL in sync. Avoid Windows reserved port ranges.
REDIS_PORT=16379
REDIS_URL=redis://127.0.0.1:16379
# 32 cryptographically random bytes, Base64. pnpm setup:env generates this locally.
ENCRYPTION_KEY=
# mock never calls external Meta/Google/OpenAI/Telegram services.
INTEGRATIONS_MODE=mock
META_APP_SECRET=
META_VERIFY_TOKEN=
# Explicitly choose currently supported Graph version from your Meta App dashboard for live mode.
META_GRAPH_VERSION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AI Sales Local <no-reply@localhost.test>
# Optional initial Super Admin. Set both before pnpm db:seed. Never commit these values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Integration secrets and per-page config are saved by Super Admin in dashboard, encrypted at rest.
