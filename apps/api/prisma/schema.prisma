generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PAGE_MANAGER
}
enum ProductSegment {
  POPULAR
  MID
  PREMIUM
}
enum ConversationStatus {
  AI_ACTIVE
  NEEDS_HUMAN
  TAKEN_OVER
  WAITING_CONFIRMATION
}
enum MessageDirection {
  INBOUND
  OUTBOUND
}
enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}
enum DeliveryStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
}
enum WebhookStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            UserRole  @default(PAGE_MANAGER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  sessions        Session[]
  verifications   EmailVerification[]
  memberships     PageMember[]
  auditLogs       AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfHash  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model Page {
  id                   String   @id @default(cuid())
  name                 String
  externalPageId       String   @unique
  aiEnabled            Boolean  @default(true)
  settings             Json     @default("{}")
  messengerTokenEnc    String?
  googleCredentialsEnc String?
  telegramTokenEnc     String?
  lastSyncedAt         DateTime?
  syncError            String?
  createdAt            DateTime @default(now())
  members              PageMember[]
  products             Product[]
  conversations        Conversation[]
  webhookEvents        WebhookEvent[]
  notifications        Notification[]
  auditLogs            AuditLog[]
}

model PageMember {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, pageId])
  @@index([pageId])
}

model Product {
  id            String         @id @default(cuid())
  pageId        String
  page          Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sku           String
  name          String
  segment       ProductSegment @default(POPULAR)
  description   String         @default("")
  dimensions    String         @default("")
  imageUrl      String         @default("")
  stock         Int?
  active        Boolean        @default(true)
  basePrice     Int?
  minPrice      Int?
  maxPrice      Int?
  dataError     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  quotes        Quote[]
  @@unique([pageId, sku])
  @@index([pageId, active])
}

model Conversation {
  id                    String             @id @default(cuid())
  pageId                String
  page                  Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customerId            String
  customerName          String?
  status                ConversationStatus @default(AI_ACTIVE)
  aiEnabled             Boolean            @default(true)
  version               Int                @default(0)
  lastCustomerMessageAt DateTime?
  interestedProductId   String?
  interestedProduct     Product?           @relation(fields: [interestedProductId], references: [id], onDelete: SetNull)
  handoffReason         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  messages              Message[]
  quotes                Quote[]
  notifications         Notification[]
  @@unique([pageId, customerId])
  @@index([pageId, status, updatedAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?          @unique
  text           String
  direction      MessageDirection
  sender         MessageSender
  deliveryStatus DeliveryStatus   @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  @@index([conversationId, createdAt])
}

model Quote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  amount         Int
  floor          Int
  step           Int          @default(0)
  createdAt      DateTime     @default(now())
  @@index([conversationId, productId, createdAt])
}

model WebhookEvent {
  id        String        @id @default(cuid())
  eventKey  String        @unique
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  payload   Json
  status    WebhookStatus @default(PENDING)
  attempts  Int           @default(0)
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, createdAt])
}

model Notification {
  id             String             @id @default(cuid())
  pageId         String
  page           Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  error          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([pageId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  @@index([pageId, createdAt])
  @@index([actorId, createdAt])
}
